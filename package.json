{
  "name": "realtysarv",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "npm --prefix server run dev",
    "db:up": "docker compose up -d mongo",
    "db:seed": "npm --prefix server run seed",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "npm --prefix server run seed:reset && (node --test --test-concurrency=1 tests/api.test.mjs tests/e2e.test.mjs; code=$?; npm --prefix server run cleanup:qa; exit $code)",
    "test:api": "node --test tests/api.test.mjs",
    "test:e2e": "npm --prefix server run seed:reset && node --test tests/e2e.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^10.0.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
