# Server Environment Variables
PORT=4000

# MongoDB (local: `docker compose up -d` from the repo root, or use a MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017
# Registry of client companies. Each client also gets its own database named rs_<subdomain>.
MASTER_DB=realtysarv_master

# Your root domain. A client 'acme' is served at acme.<BASE_DOMAIN> (and acme.localhost in development).
BASE_DOMAIN=realtysarv.com

# Secret used to sign login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# Off by default: each company's admin adds their own team. Set to true to show 'Create account' on sign-in pages.
ALLOW_SELF_SIGNUP=false


# Development only: let the browser pick the company with an X-Workspace header (for hosts without subdomains, e.g. GitHub Codespaces).
# Leave false in production, where the company always comes from the address.
ALLOW_WORKSPACE_HEADER=false
